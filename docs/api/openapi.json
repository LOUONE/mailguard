{
  "openapi": "3.1.0",
  "info": {
    "title": "mailguard",
    "summary": "Phishing detection for raw email, with calibrated scores and reasons.",
    "version": "0.1.1"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness (the process answers) and readiness (a model is loaded).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The model is not loaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/predict": {
      "post": {
        "summary": "Predict",
        "description": "Score one raw email.",
        "operationId": "predict_v1_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "503": {
            "description": "The model is not loaded."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Why the model is not ready."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "ModelRef": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "operating_point": {
            "type": "string",
            "title": "Operating Point",
            "description": "FPR target the threshold was chosen for."
          },
          "threshold": {
            "type": "number",
            "title": "Threshold",
            "description": "Scores strictly above it are labelled phishing."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "version",
          "operating_point",
          "threshold"
        ],
        "title": "ModelRef"
      },
      "PredictRequest": {
        "properties": {
          "raw": {
            "type": "string",
            "minLength": 1,
            "title": "Raw",
            "description": "The whole message, headers and body, as RFC 5322 text; or the base64 of its bytes when `encoding` is `base64` (for messages that are not valid UTF-8)."
          },
          "encoding": {
            "type": "string",
            "enum": [
              "text",
              "base64"
            ],
            "title": "Encoding",
            "default": "text"
          },
          "base_rate": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Rate",
            "description": "Share of phishing in the mailbox this message comes from, used to convert the score into `probability`. Defaults to the service setting."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "v1",
            "title": "Schema Version",
            "default": "v1"
          },
          "label": {
            "type": "string",
            "enum": [
              "phishing",
              "legitimate"
            ],
            "title": "Label"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Calibrated probability at the base rate of the training data. The label compares this score with the threshold."
          },
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability",
            "description": "The score converted to `base_rate`."
          },
          "base_rate": {
            "type": "number",
            "title": "Base Rate"
          },
          "model": {
            "$ref": "#/components/schemas/ModelRef"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons",
            "description": "Features that moved the score most, largest first."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "score",
          "probability",
          "base_rate",
          "model",
          "reasons"
        ],
        "title": "PredictResponse"
      },
      "Reason": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature",
            "description": "`<group>__<name>`; TF-IDF terms are `text__word:...`."
          },
          "group": {
            "type": "string",
            "title": "Group"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution",
            "description": "Additive contribution to the log-odds."
          },
          "direction": {
            "type": "string",
            "enum": [
              "phishing",
              "legitimate"
            ],
            "title": "Direction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature",
          "group",
          "contribution",
          "direction"
        ],
        "title": "Reason"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
