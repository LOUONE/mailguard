# Copy to .env and adjust. The real .env is gitignored.
# All settings are optional — defaults are safe for local dev.

# Deployment environment: dev | test | prod
MAILGUARD_ENVIRONMENT=dev

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
MAILGUARD_LOG_LEVEL=INFO

# JSON log lines (default) or coloured console lines for development.
# MAILGUARD_LOG_JSON=true

# Where downloaded corpora and local artefacts live (gitignored).
MAILGUARD_DATA_DIR=data

# MLflow tracking backend and artifact folder for `make train` (both gitignored by default).
# MAILGUARD_MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
# MAILGUARD_MLFLOW_ARTIFACT_DIR=mlruns/artifacts

# Application name (rarely overridden)
# MAILGUARD_APP_NAME=mailguard

# Serving: the API serves the registered version behind this alias (`make promote` sets it).
# MAILGUARD_MODEL_NAME=mailguard-lightgbm
# MAILGUARD_MODEL_ALIAS=production
# Operating point whose threshold decides the label: 1pct | 01pct
# MAILGUARD_OPERATING_POINT=1pct
# Share of phishing in the mailboxes served, to convert scores into probabilities.
# MAILGUARD_BASE_RATE=0.01

# Drift monitoring: where the API appends feature vectors (numbers only), and where the drift
# job writes its summary, which the API exposes as metrics. Unset: no recording.
# MAILGUARD_FEATURE_LOG_DIR=data/traffic
# MAILGUARD_DRIFT_DIR=data/drift
